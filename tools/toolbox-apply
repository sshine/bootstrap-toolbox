#!/usr/bin/env bash
# Render one service with kubenix and apply it — the in-pod equivalent of having
# kubenix on the jumphost. Human-invoked, one service at a time; this is the
# deliberate (non-Keel) deploy track. CRDs go first so their instances validate
# on the same apply pass.
#
# Usage: toolbox-apply <service> [--dry-run]
#   Renders `.#<service>` from the flake at $TOOLBOX_REPO (default: cwd).
set -euo pipefail

svc="${1:-}"
if [ -z "$svc" ]; then
  echo "usage: toolbox-apply <service> [--dry-run]" >&2
  exit 2
fi
shift

repo="${TOOLBOX_REPO:-.}"
extra=("$@")

result=$(nix build "${repo}#${svc}" --no-link --print-out-paths)

apply=(kubectl apply --server-side --force-conflicts --field-manager=toolbox "${extra[@]}")

crds=$(jq '[.items[] | select(.kind == "CustomResourceDefinition")] | length' "$result")
if [ "$crds" -gt 0 ]; then
  echo "--- applying $crds CRD(s) first ---"
  jq '{apiVersion, kind, items: [.items[] | select(.kind == "CustomResourceDefinition")]}' "$result" \
    | "${apply[@]}" -f -
  echo "--- waiting for CRDs to establish ---"
  sleep 3
fi

echo "--- applying $svc ---"
"${apply[@]}" -f "$result"
